{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the local QiRing vault window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-create-vault",
    "allow-unlock-vault-master",
    "allow-unlock-vault-recovery",
    "allow-regenerate-recovery-key",
    "allow-save-recovery-key-dialog",
    "allow-lock-vault",
    "allow-touch-activity",
    "allow-add-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-undo-delete",
    "allow-list-items",
    "allow-get-item",
    "allow-get-totp-code",
    "allow-generate-password",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-get-settings",
    "allow-update-settings",
    "allow-health-report",
    "allow-choose-backup-directory",
    "allow-export-backup-dialog",
    "allow-select-backup-file",
    "allow-preview-selected-backup",
    "allow-import-selected-backup",
    "allow-list-snapshots",
    "allow-restore-snapshot",
    "allow-rotate-master-password",
    "allow-get-security-status",
    "allow-vault-exists",
    "allow-copy-secret",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
