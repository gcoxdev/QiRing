{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QiRing",
  "version": "0.1.0",
  "identifier": "dev.qiring.desktop",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QiRing",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": ["dmg", "msi", "appimage", "deb"],
    "createUpdaterArtifacts": false
  }
}
